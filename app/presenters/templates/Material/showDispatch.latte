{block content}
{include 'headerMaterial.latte'}
<div class="content">
    {ifset $dispatch->ID}
            <div class="row delivery-note-header">
                <div class="col-sm-12">
                <div class="float-right delivery-note-status"><span class="font-weight-bold"><span class="{if $dispatch->MnozstviVC == $dispatch->MnozstviPozad}text-success{elseif $dispatch->MnozstviVC > $sumaRequests}text-warning{else}text-danger{/if}">{$dispatch->MnozstviVC|number:2}</span> / {$sumaRequests|number:2}</span></div>
                {if $dispatchType == 'own'}
                    <h1>Vlastní spotřeba</h1> 
                {elseif $dispatchType == 'def'}
                    <h1>Zmetky</h1> 
                {elseif $dispatchType == 'undo'}
                    <h1>Storno výdejky</h1> 
                {else}
                    {ifset $dispatch->RadaPrikaz}
                        <h1>Přík {$dispatch->Prikaz} ({$dispatch->Alias})</h1> 
                    {else}
                        <h1>Přík {$dispatch->SdruzPrik}</strong>{*Oper: {$dispatch->BarCodeOper}*}</h1>
                    {/ifset}
                {/if}
                </div>
            </div>
            <div class="row delivery-note-status">
                <div class="col-sm-12">
                    {if $dispatch->StavDispExp !== 1}
                        <div class="set-dn-form">
                            {include '../../templates/components/readBarCodeForm.latte', form => readBarCodeForm}
                        </div>
                    {/if}
                </div>
            </div>
        <div class="delivery-note-content">
            <div class="row delivery-note-items">
                <div class="col-sm-12">
                    <table class="table table-bordered table-striped table-sm">
                        <thead class="thead-light">
                            <tr>
                                <th scope="col">Výdejka</th>
                                <th scope="col">Připraveno</th>
                            </tr>
                        </thead>
                        <tbody>
                            {foreach $dispatchItems as $dispatchItem}
                                <tr class="clickable-row" data-href="{link dispatchItemDetail $dispatchItem->DispatchItemID}">
                                    <td class="text-center">{$dispatchItem->Nazev}</td>
                                    <td class="text-center font-weight-bold {if $dispatchItem->MnozstviVC == $dispatchItem->Mnozstvi}text-success{elseif $dispatchItem->MnozstviVC > $dispatchItem->Mnozstvi}text-warning{else}text-danger{/if}">{$dispatchItem->MnozstviVC|number:2}</td>
                                    <!-- td class="text-right text-nowrap">
                                        <a n:href="dispatchItemDetail $dispatchItem->DispatchItemID" class="btn btn-lg btn-primary mr-2"><i class="far fa-info"></i></a>
                                        <a n:href="removeDispatchItem! $dispatchItem->DispatchItemID" n:if="($dispatch->StavDispExp == 0)" class="btn btn-lg btn-danger mr-2 ajax" data-nette-confirm="modal" data-nette-confirm-title="Zrušení výdeje položky" data-nette-confirm-text="Opravu chcete zrušit výdej u vybrané položky?" data-nette-confirm-ok-class="btn-danger" data-nette-confirm-ok-text="Ano" data-nette-confirm-cancel-class="btn-secondary" data-nette-confirm-cancel-text="Ne"><i class="far fa-trash-alt"></i></a>
                                    </td -->
                                </tr>
                            {/foreach}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {ifset $requestItems}
        <div class="delivery-note-content">
            <div class="row delivery-note-items">
                <div class="col-sm-12">
                    <table class="table table-bordered table-striped table-sm">
                        <thead class="thead-light">
                            <tr>
                                <th scope="col">Materiál / délka [mm]</th>
                                <th scope="col">Požadavek</th>
                            </tr>
                        </thead>
                        <tbody>
                            {foreach $requestItems as $requestItem}
                                <tr>
                                    <td class="text-center">{$requestItem->Nazev}<br /><strong>{$requestItem->KsZadane|number:0} x {$requestItem->DelkaSleeve|number:0}</strong></td>
                                    <td class="text-center font-weight-bold">{$requestItem->MnozZadane|number:2}</td>
                                </tr>
                            {/foreach}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {/ifset}
                <div class="text-center">
                    {if $dispatch->StavDispExp == 1}
                        <span class="text-danger font-weight-bold">Uzavřeno: {$dispatch->DatUzavrenoExp}</span>
                    {else}
                    <a n:href="closeDispatch!" n:if="($dispatch->StavDispExp == 0)" class="btn btn-success btn-lg m-1"><i class="far fa-forklift"></i> Uzavřít výdej</a>
                    {/if}
                </div>
    {/ifset}
</div>
