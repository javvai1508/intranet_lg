{block content}
{include 'headerMaterial.latte'}
<div class="content">
            <div class="row delivery-note-header">
                <div class="col-sm-12">
                <div class="float-right delivery-note-status"><span class="{if $receipt->Mnozstvi == $receipt->MnozstviDL}text-success{elseif $receipt->Mnozstvi > $receipt->MnozstviDL}text-warning{else}text-danger{/if}">{$receipt->Mnozstvi|number:2}</span> / {$receipt->MnozstviDL|number:2}</span></div>
                <h1>DL: {$receipt->CisloDL}</h1>
                {$receipt->Firma}
                <strong>{$receipt->DatumDL}</strong>
                </div>
            </div>
            <div class="row delivery-note-status">
                {if $receipt->StavRcpExp !== 1}
                    <div class="col-sm-12">
                        <div class="set-dn-form">
                            {include '../components/readBarCodeForm.latte', form => receiptReadBarCodeForm}
                        </div>
                    </div>
                {/if}
            </div>
        <div class="delivery-note-content">
            <div class="row delivery-note-items">
                <div class="col-sm-12">
                    <table class="table table-bordered table-striped table-sm">
                        <thead class="thead-light">
                            <tr>
                                <th scope="col">Materiál</th>
                                <th scope="col">DL</th>
                                <th scope="col">Příjem</th>
                                <th scope="col">Zbývá</th>
                            </tr>
                        </thead>
                        <tbody>
                            {foreach $receiptItems as $receiptItem}
                                <tr class="clickable-row" data-href="{link receiptItemDetail $receiptItem->ReceiptItemID}">
                                    <td class="text-left">{$receiptItem->Nazev}<br />Obj: {$receiptItem->Objednavka}</td>
                                    <td class="text-center">{$receiptItem->MnozstviDL|number:2}</td>
                                    <td class="text-center">{$receiptItem->Mnozstvi|number:2}</td>
                                    <td class="text-center">{($receiptItem->MnozstviDL - $receiptItem->Mnozstvi)|number:2}</td>
                                </tr>
                            {/foreach}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
                <div class="text-center">
                    {if $receipt->StavRcpExp == 1}
                        <span class="text-danger font-weight-bold">Uzavřeno: {$receipt->DatUzavrenoExp}</span>
                    {else}
                    <a n:href="closeReceipt!" n:if="($receipt->StavRcpExp == 0)" class="btn btn-success btn-lg m-1"><i class="far fa-forklift"></i> Uzavřít příjem</a><br />
                    <a n:href="closeReceiptQuick!" n:if="($receipt->StavRcpExp == 0)" class="btn btn-warning btn-lg m-1"><i class="far fa-fighter-jet"></i> Uzavřít příjem ihned</a>
                    {/if}
                </div>
</div>
