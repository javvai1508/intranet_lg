{block content}
{translator sign /}
<div class="row content sign">
    <div class="col-sm-4 offset-sm-4 col-lg-2 offset-lg-5 text-center">
        <h3>Přihlášení</h3>
        {form signInForm}

            {foreach $form->controls as $input}
                {if $input->name == "remember"}
                    <div class="form-check mb-2">
                        <input n:name=remember />
                        <label>{_sign.remember}</label>
                    </div>
                {elseif $input->name == "send"}
                    {input $input}
                {else}
                    <div class="input-group mb-2">	
                        {input $input}
                        {if $input->name == "username"}
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="far fa-user"></i></span>
                            </div>
                        {/if}
                    </div>	
                {/if}
            {/foreach}
            <ul class=error n:if="$form->ownErrors">
                <li n:foreach="$form->ownErrors as $error">{$error}</li>
            </ul>
        {/form}
        <div class="clearfix"></div>
    </div>
</div>

