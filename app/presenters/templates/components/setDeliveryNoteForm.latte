<form n:name = $form class="form">
        <div class="form-group row">
        <div class="col-sm-3">{label ParovaciZnak}</div>
        <div class="col-sm-9">    
            <div class="input input-group input-group-lg mr-2">
                {input ParovaciZnak autofocus => true}
            </div>    
        </div>
    </div>    
    <div class="form-group row">
        <div class="col-sm-12">{input send}</div>
    </div>	
</form>
