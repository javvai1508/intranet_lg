<form n:name = $form class="form">
    <div class="form-group row">
        <div class="col-sm-12">    
            <div class="input input-group mr-2">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="inputGroup"><i class="far fa-barcode-scan"></i></span>
                </div>
                {input VyrCislo autofocus => true}
            </div>    
        </div>
    </div>	
    {*
    <div class="form-check form-check-inline">
        {input TisknoutStitek:}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{label TisknoutStitek:}
    </div>	*}
    <div class="form-group row">
        <div class="col-sm-12">{input send}</div>
    </div>	
</form>
