<form n:name = $form>
    <div class="form-group row">
        <div class="col-sm-3">{label CisloOrg}</div><div class="col-sm-2" odkaz="{link changeCisloOrg!}">{input CisloOrg}</div><div class="col-sm-7 autocomplete" odkaz="{link autocompleteFirma!}">{input Firma}</div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3">{label Mnozstvi}</div><div class="col-sm-4">{input Mnozstvi}</div><div class="col-sm-5"></div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3">{label Nazev}</div><div class="col-sm-9">{input Nazev}</div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3">{label VPrumerJadra}</div><div class="col-sm-4">{input VPrumerJadra}</div><div class="col-sm-5"></div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3">{label VPrumerPogumu}</div><div class="col-sm-4">{input VPrumerPogumu}</div><div class="col-sm-5"></div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3">{label VDelkaPogumu}</div><div class="col-sm-4">{input VDelkaPogumu}</div><div class="col-sm-5"></div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3">{label VDelkaValce}</div><div class="col-sm-4">{input VDelkaValce}</div><div class="col-sm-5"></div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3">{label VCepL}</div><div class="col-sm-4">{input VCepL}</div><div class="col-sm-5"></div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3">{label VCepP}</div><div class="col-sm-4">{input VCepP}</div><div class="col-sm-5"></div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3">{label TisknoutKusy:}</div><div class="col-sm-1">{input TisknoutKusy:}</div><div class="col-sm-8"></div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3">{label Poznamka}</div><div class="col-sm-9">{input Poznamka}</div>
    </div>
    <div class="form-group row">	
        <div class="col-sm-12">{input send}</div>
    </div>	
</form>
