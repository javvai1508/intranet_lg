{form startLamInventoryForm}
    <div class="form-group row">
        <div class="col-sm-3 text-right">{label VyrCislo}</div><div class="col-sm-9" odkaz="{link changeVyrCislo!}">    
            <div class="input input-group mr-2">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="inputGroup"><i class="far fa-barcode-scan"></i></span>
                </div>
                {input VyrCislo autofocus => true}
            </div>    
        </div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3 text-right"><label>Typ, průměr, název</label></div><div class="col-sm-9"></div>
    </div>
    <div class="form-group row">
        <div class="col-sm-2 text-right" id="selectTypLaminatu" odkaz="{link changeTypLaminatu!}">{input TypLaminatu}</div>
        <div class="col-sm-2" id="selectPrumerLaminatu" odkaz="{link changePrumerLaminatu!}">
            {snippet prumerLaminatu}{input Prumer1}                                        
                <script language="javascript" type="text/javascript">
                    if (typeof jQuery !== 'undefined') {
                        attachListener();
                    }
                </script>
            {/snippet}
        </div>
        <div class="col-sm-8">{snippet nazevLaminatu}{input Nazev}{/snippet}</div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3 text-right">{label TisknoutStitek:}</div><div class="col-sm-1">{input TisknoutStitek:}</div><div class="col-sm-8"></div>
    </div>
    <div class="form-group row">	
        <div class="col-sm-12 text-right">{input send}</div>
    </div>	
{/form}
