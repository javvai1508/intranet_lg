<form n:name = $form class="text-center">
    <div class="input input-group input-group-sm mr-2">
        <div class="input-group-prepend">
            <span class="input-group-text" id="inputGroup-sizing-sm"><i class="far fa-sort-numeric-up"></i></span>
        </div>
        {input quantity}
        <div class="input-group-append">
            {input send}
            {*<button class="btn btn-outline-secondary set-quantity" type="button"><i class="far fa-check"></i></button>*}
        </div>
    </div>    
</form>
