<form n:name = $form class="form-inline">
    <div class="input input-group input-group-lg mr-2">
        <div class="input-group-prepend">
            <span class="input-group-text" id="inputGroup-sizing-sm"><i class="far fa-clipboard-list"></i></span>
        </div>
        {input CisloKarty}
        <div class="input-group-append">
            <button class="btn btn-outline-secondary nullsearchdn" type="button"><i class="far fa-search"></i></button>
        </div>
    </div>    
    <div class="input-group input-group-lg mr-2">	
        {input send}
    </div>	
    <div class="input-group input-group-sm mr-2">	
        <a href="" role="button" class="btn btn-primary btn-lg">Nová karta</a>
    </div>	
</form>
