<form n:name = $form class="text-center">
    <div class="input input-group input-group-sm mr-2">
        <div class="input-group-prepend">
            <span class="input-group-text" id="inputGroup-sizing-sm"><i class="far fa-sort-numeric-up"></i></span>
        </div>
        {input quantity}
    </div>
    <div class="mt-2 text-right">
        <button n:name="cancel" class="btn btn-sm btn-secondary mr-2"><i class="far fa-times"></i> Storno</button> <button n:name="send" class="btn btn-success btn-sm"><i class="far fa-check"></i> Odvést</button>
    </div>    
</form>
