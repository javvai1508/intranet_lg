<form n:name = $form class="form">
        {if $deliveryNote->DoplnitBaleni == 1}
        <div class="form-group row">
            <div class="col-sm-3">{label BaleniTx}</div>
            <div class="col-sm-9">    
                <div class="input input-group input-group-lg mr-2">
                    {input BaleniTx autofocus => true}
                </div>    
            </div>
        </div>    
        {/if}
        <div class="col-12 text-center">
            {input send}&nbsp;&nbsp;&nbsp;{input cancel}
        </div>	
</form>
