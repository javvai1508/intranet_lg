<form n:name = $form>
    <div class="form-group row">
        <div class="col-sm-3">{label CisloOrg}</div><div class="col-sm-2" odkaz="{link changeCisloOrg!}">{input CisloOrg}</div><div class="col-sm-7 autocomplete" odkaz="{link autocompleteFirma!}">{input Firma}</div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3">{label ParovaciZnak}</div><div class="col-sm-4 autocomplete" odkaz="{link autocompleteParovaciZnak!}" odkaz-blur="{link blurParovaciZnak!}">{input ParovaciZnak}</div><div class="col-sm-5"></div>
    </div>
    <div class="form-group row">	
        <div class="col-sm-12">{input send}</div>
    </div>	
</form>
