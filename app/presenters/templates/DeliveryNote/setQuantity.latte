{block content}
{include 'headerDeliveryNote.latte'}
<div class="content">
    {ifset $deliveryNote->UmisteniKod}
        <div class="row delivery-note-items">
            <div class="col-sm-12">
                <h4>Detail položky dodacího listu</h4>
                <table class="table table-bordered table-sm">
                    <thead class="thead-light">
                        <tr>
                            <th scope="col">Zak/pol</th>
                            <th scope="col">Výkres</th>
                            <th scope="col">Rozměry</th>
                            <th scope="col">Požadavek</th>
                            <th scope="col">Připraveno</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {if isset($deliveryNoteItem)}
                            <tr>
                                <td class="text-center">{$deliveryNoteItem->Zakazka}</td>
                                <td class="text-center">{$deliveryNoteItem->Vykres}</td>
                                <td class="text-center">{$deliveryNoteItem->Rozmery}</td>
                                <td class="text-center font-weight-bold">{$deliveryNoteItem->Mnozstvi}</td>
                                <td class="text-center font-weight-bold {if $deliveryNoteItem->MnozstviVC == $deliveryNoteItem->Mnozstvi}text-success{elseif $deliveryNoteItem->MnozstviVC > $deliveryNoteItem->Mnozstvi}text-warning{else}text-danger{/if}">{$deliveryNoteItem->MnozstviVC}</td>
                                <td class="text-right">
                                    <a n:href="removeDeliveryNoteItem! $deliveryNoteItemId" n:if="($deliveryNote->StavDLExp == 0)" class="btn btn-lg btn-danger mr-2 ajax" data-nette-confirm="modal" data-nette-confirm-title="Zrušení přípravy" data-nette-confirm-text="Opravu chcete zrušit přípravu u vybrané položky?" data-nette-confirm-ok-class="btn-danger" data-nette-confirm-ok-text="Ano" data-nette-confirm-cancel-class="btn-secondary" data-nette-confirm-cancel-text="Ne"><i class="far fa-trash-alt"></i></a>
                                </td>
                            </tr>
                        {/if}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row delivery-note-item-sn">
            <div class="col-sm-12">
                <h4>Nové výrobní číslo na dodací list</h4>
                {snippet itemSNTable}
                    <table class="table table-bordered table-sm">
                        <thead class="thead-light">
                            <tr>
                                <th scope="col" class=" text-right">Výrobní číslo</th>
                                <th scope="col">{$serialNumberRow->BarCode}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row" class=" text-right">Přidat na DL</th>
                                <td class="text-center">{include '../components/setQuantityForm.latte', form => setQuantityForm}</td>
                            </tr>
                            <tr>
                                <th scope="row" class=" text-right">Množství skladem</th>
                                <td class="text-center">{$serialNumberRow->MnozstviPoPrijmuAVydeji}</td>
                            </tr>
                            <tr>
                                <th scope="row" class=" text-right">Množství požadované</th>
                                <td class="text-center">{$serialNumberRow->MnozstviPozadavek}</td>
                            </tr>
                        </tbody>
                    </table>
                {/snippet}
            </div>
        </div>
    {/ifset}
</div>
