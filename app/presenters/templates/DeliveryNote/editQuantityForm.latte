<form n:name = $form class="text-center">
    <div class="input input-group input-group-lg">
        {input quantity}
        <div class="input-group-append">
            <button class="btn btn-outline-secondary set-quantity" type="button"><!-- i class="far fa-check"></i -->OK</button>
        </div>
    </div>    
</form>

